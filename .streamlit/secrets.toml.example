# Copy this file to .streamlit/secrets.toml and fill in your own values.
# secrets.toml is in .gitignore: it must NEVER be committed or shared.
# If any value is missing, the app runs as an open demo (no login).

[auth]
# Where Clerk sends the user back after sign-in. Must ALSO be listed in your Clerk OAuth application.
#   On your laptop:          http://localhost:8501/oauth2callback
#   On Streamlit Cloud:      https://<your-app-name>.streamlit.app/oauth2callback
redirect_uri = "http://localhost:8501/oauth2callback"

# Any long random text. Make one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "paste-a-long-random-string-here"

# From Clerk Dashboard -> OAuth applications -> your application
client_id = "paste-your-clerk-oauth-client-id"
client_secret = "paste-your-clerk-oauth-client-secret"

# Your Clerk Frontend API URL + /.well-known/openid-configuration
# Example shape: https://<something>.clerk.accounts.dev/.well-known/openid-configuration
server_metadata_url = "https://YOUR-FRONTEND-API/.well-known/openid-configuration"
